@model IEnumerable<EStudentManagement.Web.Models.Student>

@{
    ViewData["Title"] = "Manage Students";
}

<h2>Manage Students</h2>

@if (TempData["success"] != null)
{
    <div class="alert alert-success">
        @TempData["success"]
    </div>
}

@if (TempData["error"] != null)
{
    <div class="alert alert-danger">
        @TempData["error"]
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Date of Birth</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Name</td>
                <td>@student.Email</td>
                <td>@student.DateOfBirth.ToString("yyyy-MM-dd")</td>
                <td>
                    <a href="@Url.Action("EditStudent", "Admin", new { id = student.Id })" class="btn btn-warning btn-sm" style="width:80px">Edit</a>
                    <a href="@Url.Action("StudentDetails", "Admin", new { id = student.Id })" class="btn btn-dark btn-sm" style="width:80px">View</a>
                    <a href="@Url.Action("ConfirmDelete", "Admin", new { id = student.Id })" class="btn btn-danger btn-sm" style="width:80px">Delete</a>

                </td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("AddStudent", "Admin")" class="btn btn-primary">Add Student</a>
<a href="@Url.Action("Index", "Admin")" class="btn btn-primary">Back to Dashboard</a>

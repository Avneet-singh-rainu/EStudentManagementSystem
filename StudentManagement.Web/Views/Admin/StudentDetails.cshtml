@model EStudentManagement.Web.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<h2>@Model.Name's Details</h2>

<div class="card">
    <div class="card-header">
        <h5 class="card-title">@Model.Name</h5>
    </div>
    <div class="card-body">
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Date of Birth:</strong> @Model.DateOfBirth.ToString("yyyy-MM-dd")</p>
    </div>
    <div class="card-footer">
        <a href="@Url.Action("GetAllStudents", "Admin")" class="btn btn-secondary">Back to Students</a>
    </div>
</div>
